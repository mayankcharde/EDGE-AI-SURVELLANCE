# Camera
RTSP_URL=rtsp://username:password@192.168.1.10:554/stream
CAMERA_NAME=Main Entrance

# Email Alerts
EMAIL_ENABLED=true
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ALERT_EMAIL_TO=security@example.com

# Telegram Alerts
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_CHAT_ID=123456789

# Behavior thresholds
LOITERING_SECONDS=10
RUNNING_SPEED_THRESHOLD=80
FALL_ASPECT_RATIO=1.2
DIRECTION_CHANGE_THRESHOLD=5
INTRUSION_COOLDOWN=30

# Source: "webcam" for laptop camera, "rtsp" for IP camera, "video" for a file
SOURCE_TYPE=webcam
WEBCAM_INDEX=0
RTSP_URL=
VIDEO_PATH=